<?xml version="1.0"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
   <Product Id="C59F060C-D728-412B-B837-ED2A11A3BAFE"
            Name="WindowTabs"
            Language="2052"
            Version="0.0.70"
            Manufacturer="Regis Martinez"
            UpgradeCode="6763D234-BCFA-4172-8190-756DEE9CF2B1">

      <Package Compressed="yes"/>

      <Media Id="1" Cabinet="product.cab" EmbedCab="yes"/>

      <!-- needs program menu addition, + path installation request, + ... -->
      <Directory Name="SourceDir" Id="TARGETDIR">
         <Directory Name="ProgramFilesFolder" Id="ProgramFilesFolder">
            <Directory Name="WindowTabs" Id="_1">
               <Component Id="_1" Guid="3C67513D-01DD-4637-8A68-80971EB9504F">
                  <File Source="Banner.bmp"/>
                  <File Source="..\WtProgram\Resources\Bemo.ico"/>
                  <File Source="$(var.WtProgram.TargetDir)\WindowTabs.exe"/>
                  <File Source="$(var.WtProgram.TargetDir)\WindowTabs.exe.config"/>
               </Component>
               <!-- Simplified Chinese satellite assembly. It must sit in a "zh-CN"
                    subfolder, otherwise the UI falls back to English. -->
               <Directory Name="zh-CN" Id="_1_zhCN">
                  <Component Id="_1_zhCN" Guid="066D5014-CF22-44E9-85DD-07C43207EF2A">
                     <File Source="$(var.WtProgram.TargetDir)\zh-CN\WindowTabs.resources.dll"/>
                  </Component>
               </Directory>
            </Directory>
         </Directory>
      </Directory>

      <Feature Id="_1" Level="1">
         <ComponentRef Id="_1"/>
         <ComponentRef Id="_1_zhCN"/>
      </Feature>

   </Product>
</Wix>
